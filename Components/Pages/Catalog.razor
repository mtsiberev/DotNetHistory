@page "/catalog"
@using DotNetHistory.Models
@using DotNetHistory.Services
@inject IFeatureService FeatureService
@inject CodeSandboxService SandboxService
@rendermode InteractiveServer

<div class="container-fluid" style="height: calc(100vh - 80px); margin-top: 15px;">
    <div class="row h-100">

        <div class="col-md-4 border-end bg-light p-3" style="overflow-y: auto; height: 100%;">
            <h5 class="mb-3 text-muted">Хронологическая база знаний .NET</h5>
            <hr />

            @if (versions == null)
            {
                <p><em>Загрузка истории...</em></p>
            }
            else
            {
                @foreach (var version in versions)
                {
                    <div class="mb-4">
                        <span class="badge bg-secondary mb-2 d-inline-block">@version.Name</span>

                        @if (version.Features == null || !version.Features.Any())
                        {
                            <div class="text-muted ps-2 small fst-italic">Нет зарегистрированных фич</div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush ps-2">
                                @foreach (var feature in version.Features)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action py-1 border-0 rounded @(selectedFeature?.Id == feature.Id ? "active" : "")"
                                            @onclick="() => OnFeatureSelect(feature)">
                                        • @feature.Name
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <div class="col-md-8 p-4" style="overflow-y: auto; height: 100%;">
            @if (selectedFeature != null)
            {
                <h2 class="text-dark fw-bold">@selectedFeature.Name</h2>
                <hr />

                <div class="mb-3" style="white-space: pre-line; font-size: 1.1rem; color: #2D3748; line-height: 1.6;">
                    @selectedFeature.Description
                </div>

                @if (!string.IsNullOrEmpty(selectedFeature.DocumentationUrl))
                {
                    <div class="mb-4">
                        <a href="@selectedFeature.DocumentationUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2">
                            Документация Microsoft Learn
                        </a>
                    </div>
                }

                <div class="border-top pt-3 mt-4">
                    <ul class="nav nav-tabs mb-3" id="sandboxTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "feature" ? "active fw-bold text-primary" : "text-muted")"
                                    type="button" @onclick='() => ChangeTab("feature")'>
                                Код примера из файла
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "script" ? "active fw-bold text-success" : "text-muted")"
                                    type="button" @onclick='() => ChangeTab("script")'>
                                Песочница
                            </button>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted small">
                            @(activeTab == "feature"
                                ? "Вы можете модифицировать или полностью стереть код класса примера."
                                : "Пишите любой рабочий C# код (Top-Level Statements) напрямую.")
                        </span>

                        <button class="btn @(activeTab == "feature" ? "btn-primary" : "btn-success") btn-sm d-flex align-items-center gap-2 shadow-sm"
                                @onclick="HandleRunCustomCode"
                                disabled="@isCompiling">
                            @if (isCompiling)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Выполнение...</span>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-play-fill" viewBox="0 0 16 16">
                                    <path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z" />
                                </svg>
                                <span>Запустить мой код</span>
                            }
                        </button>
                    </div>

                    <div class="mb-3 shadow-sm rounded">
                        <textarea class="form-control bg-dark text-white p-3"
                                  spellcheck="false"
                                  style="font-family: 'Consolas', 'Monaco', monospace; font-size: 0.95rem; min-height: 380px; resize: vertical; line-height: 1.5; border-color: #2D3748;"
                                  @bind="userCode"
                                  placeholder="// Введите C# код для выполнения..."></textarea>
                    </div>

                    <h5 class="text-dark mt-4 fw-semibold">Результат выполнения (Вывод консоли):</h5>
                    <div class="p-3 rounded border shadow-sm mb-5"
                         style="background-color: #f8f9fa; font-family: 'Consolas', 'Monaco', monospace; font-size: 0.95rem; white-space: pre-wrap; text-align: left;">
                        @if (!string.IsNullOrEmpty(sandboxErrorMessage))
                        {
                            <span class="text-danger fw-bold">@sandboxErrorMessage</span>
                        }
                        else if (!string.IsNullOrEmpty(sandboxOutput))
                        {
                            <span class="text-success fw-bold">@sandboxOutput</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">// Нажмите кнопку «Запустить мой код», чтобы увидеть результат выполнения...</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex h-100 flex-column align-items-center justify-content-center text-muted">
                    <p class="fs-5">Выберите пункт в левой колонке для просмотра описания и примеров.</p>
                </div>
            }
        </div>

    </div>
</div>

@code {
    private List<DotNetVersion>? versions;
    private FeatureItem? selectedFeature;

    private string userCode = string.Empty;
    private string sandboxOutput = string.Empty;
    private string sandboxErrorMessage = string.Empty;
    private bool isCompiling = false;

    private string activeTab = "feature";

    protected override async Task OnInitializedAsync()
    {
        versions = await FeatureService.GetCatalogAsync();

        if (versions != null && versions.Any())
        {
            var firstFeature = versions.FirstOrDefault(v => v.Features != null && v.Features.Any())?.Features?.FirstOrDefault();
            if (firstFeature != null)
            {
                UpdateSelectedFeature(firstFeature);
            }
        }
    }

    private void OnFeatureSelect(FeatureItem feature)
    {
        if (selectedFeature?.Id == feature.Id) return;
        UpdateSelectedFeature(feature);
    }

    private void UpdateSelectedFeature(FeatureItem feature)
    {
        selectedFeature = feature;
        activeTab = "feature";

        userCode = feature.CodeExample ?? string.Empty;

        sandboxOutput = string.Empty;
        sandboxErrorMessage = string.Empty;
    }

    private void ChangeTab(string tabName)
    {
        if (activeTab == tabName) return;
        activeTab = tabName;

        sandboxOutput = string.Empty;
        sandboxErrorMessage = string.Empty;

        if (activeTab == "feature")
        {
            userCode = selectedFeature?.CodeExample ?? string.Empty;
        }
        else
        {
            userCode = """
            using System;
            using System.Collections.Generic;

            Console.WriteLine("Чистая песочница готова. Здесь можно писать любой Top-Level скрипт.");
            """;
        }
    }

    private async Task HandleRunCustomCode()
    {
        isCompiling = true;
        sandboxOutput = string.Empty;
        sandboxErrorMessage = string.Empty;

        SandboxResult result;

        if (activeTab == "feature")
        {
            result = await SandboxService.ExecuteFeatureAsync(userCode);
        }
        else
        {
            result = await SandboxService.ExecuteScriptAsync(userCode);
        }

        sandboxOutput = result.Output;
        sandboxErrorMessage = result.ErrorMessage;

        isCompiling = false;
    }
}